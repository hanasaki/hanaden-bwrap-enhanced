# Universal text normalization
* text=auto eol=lf

# Scripts & configs
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf

# Structured text & specs
*.md text eol=lf diff=markdown
*.json text eol=lf
*.jsonl text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.csv text eol=lf
*.txt text eol=lf

# Cryptographic manifests (never corrupt with EOL conversion)
*.sha256 text eol=lf
*.sha512 text eol=lf

# Archives & compressed
*.lock binary
*.tar binary
*.tar.* binary
*.tgz binary
*.tbz2 binary
*.txz binary
*.zip binary
*.7z binary
*.gz binary
*.bz2 binary
*.xz binary
*.zst binary
*.lz4 binary
*.br binary
*.rar binary
*.jar binary
*.war binary
*.ear binary
*.iso binary
*.dmg binary
*.cab binary
*.deb binary
*.rpm binary
*.snap binary
*.AppImage binary
*.msi binary

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.avif binary
*.bmp binary
*.tiff binary
*.tif binary
*.heic binary
*.heif binary
*.svg text eol=lf

# Video
*.mp4 binary
*.mkv binary
*.avi binary
*.mov binary
*.webm binary
*.wmv binary
*.flv binary

# Audio
*.mp3 binary
*.flac binary
*.ogg binary
*.wav binary
*.aac binary
*.m4a binary
*.wma binary

# Fonts & rich documents
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary

# Office (Microsoft)
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.ppt binary
*.pptx binary

# Office (LibreOffice / OpenDocument)
*.odt binary
*.ods binary
*.odp binary
*.odg binary
*.odf binary

# Other documents
*.epub binary
*.mobi binary

# Compiled / executable
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.a binary
*.lib binary
*.wasm binary
*.pyc binary
*.class binary

# Linguist
**/docs/** linguist-documentation
**/doc-templates/** linguist-documentation
*.sha256 linguist-generated=true
*.sha512 linguist-generated=true
**/evidence/** linguist-generated=true

# Export hygiene -- exclude IDE/OS dotfiles and temp directories
.* export-ignore
**/scratch/** export-ignore
**/tmp/** export-ignore
**/.worktrees/** export-ignore

# Override: these git config files SHOULD ship in exports
.gitattributes -export-ignore
.gitignore -export-ignore
.gitmessage -export-ignore
